<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now (no Mac for iOS), same decision as the sibling DocScanner repo. To add
		     iOS later: append net10.0-ios here and restore Platforms\iOS from the MAUI template. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>PdfReader</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance (same
		     performance lesson as DocScanner: Debug falls back to runtime inflation + the Mono
		     interpreter, which reads as "app chậm" when it is really just a Debug build). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>PDF Reader</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.tonyq.pdfreader</ApplicationId>

		<!-- Versions. Bump ApplicationVersion (Android versionCode) on every build going to a device or to Play. -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- Ads mode: independent of Configuration (Debug/Release) and of APK vs AAB. "Dev" (the
		     default, if not passed on the command line) always requests the active provider's own
		     test/sandbox ad units (LevelPlayConfig.cs), whatever is being built, so a Release .aab
		     uploaded to a Play internal/closed testing track still shows test ads and can never trigger
		     an invalid-click policy strike. Only "Pro" switches to the real ids (RealAdsConfig.cs), and
		     only when explicitly passed:
		       dotnet publish src/PdfReader -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Pro
		     for the one build that actually goes to Play for real. -->
		<AdsMode Condition="'$(AdsMode)' == ''">Dev</AdsMode>
		<DefineConstants Condition="'$(AdsMode)' == 'Pro'">$(DefineConstants);ADS_MODE_PRO</DefineConstants>

		<!-- Ads kill switch for a Play Console testing build: even test/sandbox ad creatives are real,
		     clickable UI that a reviewer or closed-tester could tap by accident, so a build meant purely to
		     verify app behaviour (not ads) can skip ads entirely with:
		       dotnet publish src/PdfReader -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsEnabled=false
		     Feeds AdsProviderOptions.IsAdsEnabled (MauiProgram.cs): the master ads switch in the shared AdsService
		     library, same property and meaning as in DocScanner. Off = the ad SDK is not even initialised and nothing
		     loads, in every build type. Independent of AdsMode above: leave AdsMode at its default. -->
		<AdsEnabled Condition="'$(AdsEnabled)' == ''">true</AdsEnabled>
		<DefineConstants Condition="'$(AdsEnabled)' == 'false'">$(DefineConstants);ADS_DISABLED</DefineConstants>

		<!-- There used to be a PdfReaderRealAdMobAppId + AndroidManifestPlaceholders pair here, gating the
		     AdMob App ID meta-data in AndroidManifest.xml on AdsMode. Removed 2026-10-11: that meta-data
		     turned out to be mandatory regardless of AdsMode or which ad provider is active (the bundled
		     Google Mobile Ads SDK crashes on startup without it: see AndroidManifest.xml's own comment on
		     that meta-data for why), so it is now just Google's published TEST App ID, hardcoded directly in
		     the manifest, unconditionally. The real production ad unit ids (for whichever provider is
		     active, LevelPlay right now) live in RealAdsConfig.cs, which is unrelated to this. -->
	</PropertyGroup>

	<!-- Same Release/Debug performance tuning as DocScanner (plan section 2): LLVM AOT in Release,
	     JIT instead of the Hot-Reload interpreter in Debug. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<EnableLLVM>true</EnableLLVM>
	</PropertyGroup>

	<!-- Release signing (Google Play upload key): keystore + passwords are NOT in this file. A new,
	     separate keystore (not DocScanner's) must be created before any Release/Play build, see
	     plan section 7 "Không tái dùng - viết mới". Not set up yet; a Release build without it falls
	     back to the debug key (fine for local testing only, never upload that AAB to Play). -->
	<Import Project="release\Signing.props" Condition="'$(Configuration)' == 'Release' AND Exists('release\Signing.props')" />

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#C0392B" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF9F3" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Plugin.AdMob 10.0.90 (see the commented-out PackageReference below) needs
		     Microsoft.Maui.Controls >= 10.0.90 (same pin as DocScanner); kept at this version regardless. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- AdMob is NOT the active ad provider (see MauiProgram.cs): this direct reference is unused;
		     AdsService.csproj's own ProjectReference already pulls Plugin.AdMob transitively for its
		     multi-provider support, which is all this app currently needs. Left commented out as part of
		     the AdMob switch-over template (PdfReader.csproj's AdMob App ID block + AndroidManifest.xml's
		     AdMob meta-data block): uncomment all three together if PdfReader switches back to AdMob.
		<PackageReference Include="Plugin.AdMob" Version="10.0.90" />
		-->
		<!-- MIT: Play Billing wrapper for the Pro unlock (Services/LicenseService.cs). -->
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<!-- Apache-2.0: Google Play In-App Updates (Platforms/Android/AndroidAppUpdate.cs). -->
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.0.1" />
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
		<PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PdfReader.Core\PdfReader.Core.csproj" />
		<ProjectReference Include="..\AdsService\AdsService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="release\" />
	</ItemGroup>

</Project>
