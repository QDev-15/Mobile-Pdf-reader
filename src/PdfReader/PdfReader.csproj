<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now (no Mac for iOS), same decision as the sibling DocScanner repo. To add
		     iOS later: append net10.0-ios here and restore Platforms\iOS from the MAUI template. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>PdfReader</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance (same
		     performance lesson as DocScanner: Debug falls back to runtime inflation + the Mono
		     interpreter, which reads as "app chậm" when it is really just a Debug build). -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>PDF Reader</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>btk.pdfreader</ApplicationId>

		<!-- Versions. Bump ApplicationVersion (Android versionCode) on every build going to a device or to Play. -->
		<ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- Ads mode: independent of Configuration (Debug/Release) and of APK vs AAB. "Dev" (the
		     default, if not passed on the command line) always requests Google's TEST ad App ID + ad
		     units, whatever is being built, so a Release .aab uploaded to a Play internal/closed testing
		     track still shows test ads and can never trigger an invalid-click policy strike. Only "Pro"
		     switches to the real ids below, and only when explicitly passed:
		       dotnet publish src/PdfReader -f net10.0-android -c Release -p:AndroidPackageFormat=aab -p:AdsMode=Pro
		     for the one build that actually goes to Play for real. -->
		<AdsMode Condition="'$(AdsMode)' == ''">Dev</AdsMode>
		<DefineConstants Condition="'$(AdsMode)' == 'Pro'">$(DefineConstants);ADS_MODE_PRO</DefineConstants>

		<!-- AdMob App ID: Google's published TEST id by default. TODO: once a real AdMob app exists for
		     PdfReader (cannot share DocScanner's, plan section 6/8), put its real App ID here. It only
		     actually gets used when AdsMode=Pro (below), and even then only once it no longer contains
		     "REPLACE_ME", so a Pro build made before AdMob is set up falls back to the test id instead of
		     crashing at startup on a malformed one. The matching ad UNIT ids are in AdsConfig.cs. -->
		<PdfReaderRealAdMobAppId>REPLACE_ME_ADMOB_APP_ID</PdfReaderRealAdMobAppId>
		<AndroidManifestPlaceholders Condition="'$(AdsMode)' == 'Pro' AND !$(PdfReaderRealAdMobAppId.Contains('REPLACE_ME'))">admobAppId=$(PdfReaderRealAdMobAppId)</AndroidManifestPlaceholders>
		<AndroidManifestPlaceholders Condition="'$(AdsMode)' != 'Pro' OR $(PdfReaderRealAdMobAppId.Contains('REPLACE_ME'))">admobAppId=ca-app-pub-3940256099942544~3347511713</AndroidManifestPlaceholders>
	</PropertyGroup>

	<!-- Same Release/Debug performance tuning as DocScanner (plan section 2): LLVM AOT in Release,
	     JIT instead of the Hot-Reload interpreter in Debug. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<EnableLLVM>true</EnableLLVM>
	</PropertyGroup>

	<!-- Release signing (Google Play upload key): keystore + passwords are NOT in this file. A new,
	     separate keystore (not DocScanner's) must be created before any Release/Play build, see
	     plan section 7 "Không tái dùng - viết mới". Not set up yet; a Release build without it falls
	     back to the debug key (fine for local testing only, never upload that AAB to Play). -->
	<Import Project="release\Signing.props" Condition="'$(Configuration)' == 'Release' AND Exists('release\Signing.props')" />

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#C0392B" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF9F3" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Plugin.AdMob 10.0.90 needs Microsoft.Maui.Controls >= 10.0.90 (same pin as DocScanner). -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MIT: banner + interstitial ads for the free tier (Services/AdsService.cs). Pulls in the
		     Google Mobile Ads SDK itself (proprietary, Google's own terms). -->
		<PackageReference Include="Plugin.AdMob" Version="10.0.90" />
		<!-- MIT: Play Billing wrapper for the Pro unlock (Services/LicenseService.cs). -->
		<PackageReference Include="Plugin.InAppBilling" Version="10.0.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<!-- Apache-2.0: Google Play In-App Updates (Platforms/Android/AndroidAppUpdate.cs). -->
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.0.1" />
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
		<PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.4.1.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PdfReader.Core\PdfReader.Core.csproj" />
		<ProjectReference Include="..\AdsService\AdsService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="release\" />
	</ItemGroup>

</Project>
