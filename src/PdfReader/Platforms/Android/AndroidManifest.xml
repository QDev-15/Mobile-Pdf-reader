<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">

		<!-- NOT a sign that AdMob is the active ad provider (it is LevelPlay: see MauiProgram.cs's
		     UseAdsService(LevelPlayOptions)). This is mandatory regardless: AdsService.csproj depends on
		     Plugin.AdMob for its multi-provider support, which pulls in the Google Mobile Ads SDK itself
		     (play-services-ads-lite) as part of the APK whether or not the app's own code ever calls it.
		     That SDK ships its own ContentProvider (MobileAdsInitProvider) which runs automatically at app
		     process start, before any app code, and throws IllegalStateException("Missing application ID")
		     if this meta-data is absent: confirmed on-device 2026-10-11, commenting this out crashed the
		     app on launch every time. Google's own published TEST App ID always satisfies this startup
		     check; using it unconditionally (not gated by AdsMode/AndroidManifestPlaceholders like before)
		     is fine precisely because AdMob is never actually used to request or show a real ad. -->
		<meta-data android:name="com.google.android.gms.ads.APPLICATION_ID"
		           android:value="ca-app-pub-3940256099942544~3347511713" />
		<activity android:name="com.google.android.gms.ads.AdActivity"
		          android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
		          android:theme="@android:style/Theme.Translucent" android:exported="false" />
	</application>

	<!-- Google Play Billing (bản Pro tắt ads) + LevelPlay ads + Play In-App Update: no server of our own;
	     the PDF itself never leaves the phone. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Required since Android 13 (API 33): without it the system zeroes out the Advertising ID for
	     every app on the device, regardless of which ad SDK reads it. Play Console's own upload check
	     (2026-10-12: "Errors, warnings and messages" on a closed-testing release) rejects an upload
	     whose manifest lacks this permission when the app's own Play Console "Advertising ID" declaration
	     (App content) says the app uses it, true here: LevelPlay (the active ad provider) uses it for ad
	     targeting/attribution. Previously came along for free via Plugin.AdMob's own transitively-bundled
	     play-services-ads-identifier; removed along with AdMob itself in the 2026-10-12 AdsService provider
	     split (dexdump-confirmed: zero com.google.android.gms.ads.* / AdvertisingIdClient classes remain in
	     the DEX), so it must be declared explicitly now. -->
	<uses-permission android:name="com.google.android.gms.permission.AD_ID" />

	<!-- MainActivity's own [IntentFilter] attributes (Platforms/Android/MainActivity.cs) declare it as a
	     target for ACTION_VIEW / ACTION_SEND of application/pdf, which is how it shows up in a file
	     manager's "Open with" / "Share" sheet (plan section 8 item 1: Android decides whether to also
	     offer "Always"; an app cannot force itself to be the default). Nothing else is needed here. -->
</manifest>
