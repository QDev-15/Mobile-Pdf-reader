<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral logic of the app (licensing, ads policy, export quality presets). No MAUI /
       Android references, so it is unit-testable on the PC. Same split as DocScanner.Core in the
       sibling Mobile-doc-scanner repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfReader.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageCore.Shared\ImageCore.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

</Project>
